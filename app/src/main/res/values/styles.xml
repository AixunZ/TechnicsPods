<resources>
    <style name="Theme.TechnicsPods" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tp_accent</item>
        <item name="colorOnPrimary">@color/tp_on_accent</item>
        <item name="colorPrimaryContainer">@color/tp_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/tp_text_primary</item>
        <item name="colorSecondary">@color/tp_accent</item>
        <item name="colorSurface">@color/tp_surface</item>
        <item name="colorOnSurface">@color/tp_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tp_text_secondary</item>
        <item name="colorOutline">@color/tp_border</item>
        <item name="android:colorBackground">@color/tp_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/tp_accent</item>
        <item name="android:windowBackground">@color/tp_background</item>
        <item name="android:navigationBarColor">@color/tp_background</item>
        <item name="android:statusBarColor">@color/tp_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="TP.Title" parent="android:style/Widget.Material.TextView">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tp_text_primary</item>
    </style>
    <style name="TP.Model" parent="android:style/Widget.Material.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tp_accent</item>
    </style>
    <style name="TP.Body" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/tp_text_primary</item>
    </style>
    <style name="TP.Caption" parent="TP.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/tp_text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="TP.Section" parent="TP.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="TP.Setting" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tp_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="TP.Command" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/tp_accent</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="TP.BatteryCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_battery_card</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:screenReaderFocusable">true</item>
        <item name="android:importantForAccessibility">yes</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
    <style name="TP.BatteryLabel" parent="TP.Body">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="TP.BatteryValue" parent="TP.Body">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">@string/value_unknown</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="TP.BatteryState" parent="TP.Caption">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">@string/state_unknown</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
